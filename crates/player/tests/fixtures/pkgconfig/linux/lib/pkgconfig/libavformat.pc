prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: libavformat
Description: FFmpeg container format library
Version: 63.1.102
Conflicts:

Libs: "-L${libdir}" -lavformat -lm "-L${prefix}/lib/pkgconfig/../../lib" -lxml2 -lm -ldl -lz "-L${prefix}/lib/pkgconfig/../../lib" -lbz2 "-L${prefix}/lib/pkgconfig/../../lib" -lz -latomic "-L${prefix}/lib/pkgconfig/../../lib" -lssl -lcrypto -ldl -pthread "-L${prefix}/lib/pkgconfig/../../lib" -lsrt -lstdc++ -lm -lssl -lcrypto -ldl -pthread "-L${prefix}/lib/pkgconfig/../../lib" -lssh -lcrypto -ldl -pthread
Requires: libavcodec >= 63.1.102, libswresample >= 7.1.102, libavutil >= 61.1.102 
Cflags: "-I${includedir}"
