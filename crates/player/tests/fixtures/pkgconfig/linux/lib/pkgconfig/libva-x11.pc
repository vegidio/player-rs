prefix=${pcfiledir}/../..
includedir=${prefix}/include
libdir=${prefix}/lib

libva_version=2.24.1
va_api_version=1.24.0
display=x11

Name: va-x11
Description: Userspace Video Acceleration (VA) X11 interface
Version: 1.24.0

Libs: "-L${libdir}" -lva-x11
Requires: libva
Cflags: "-I${includedir}"
Requires.private: x11 x11-xcb xcb xcb-dri3 xext xfixes libdrm
