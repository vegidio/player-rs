prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: shaderc
Description: Tools and libraries for Vulkan shader compilation
Version: 2026.2.1
URL: https://github.com/google/shaderc


Libs: "-L${libdir}" -lshaderc -lshaderc_util -lglslang -lSPIRV-Tools-opt -lSPIRV-Tools -lstdc++ -lm
Cflags: "-I${includedir}"
