prefix=${pcfiledir}/../..
includedir=${prefix}/include
libdir=${prefix}/lib

libva_version=2.24.1
va_api_version=1.24.0
display=wayland

Name: va-wayland
Description: Userspace Video Acceleration (VA) Wayland interface
Version: 1.24.0

Libs: "-L${libdir}" -lva-wayland
Requires: libva, wayland-client
Cflags: "-I${includedir}"
Requires.private: libdrm
